local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- Konfiguracja
local CONFIG = {
    DefaultSpeed = 16,
    DefaultJumpPower = 50,
    KnockbackMultiplier = 5,
    JumpMultiplier = 5,
    AntiSit = true
}

-- Zmienne stanu
local antiHitEnabled = false
local connections = {}
local currentCharacter = nil

-- Funkcja anti-hit
local function antiHitFunction(character)
    if not antiHitEnabled then return end
    
    for _, conn in ipairs(connections) do
        conn:Disconnect()
    end
    connections = {}
    
    currentCharacter = character
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    local function isSittingOnValidSeat()
        local seat = humanoid.SeatPart
        if seat then
            if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
                if seat.Parent and seat.Parent:IsA("Workspace") then
                    return true
                end
            end
        end
        return false
    end
    
    if CONFIG.AntiSit then
        local sitConn = humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
            if humanoid.Sit and not isSittingOnValidSeat() then
                humanoid.Sit = false
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        table.insert(connections, sitConn)
        
        local stateConn = humanoid.StateChanged:Connect(function(_, newState)
            if (newState == Enum.HumanoidStateType.Seated or newState == Enum.HumanoidStateType.PlatformStanding) and not isSittingOnValidSeat() then
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        table.insert(connections, stateConn)
    end

    local function checkAndDestroyKnockback(child)
        if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("BodyForce") or child:IsA("VectorForce") or child:IsA("BodyAngularVelocity") or child:IsA("AngularVelocity") then
            task.spawn(function()
                child:Destroy()
            end)
        end
    end

    local childAddedConn1 = rootPart.ChildAdded:Connect(checkAndDestroyKnockback)
    table.insert(connections, childAddedConn1)
    
    local childAddedConn2 = character.ChildAdded:Connect(checkAndDestroyKnockback)
    table.insert(connections, childAddedConn2)
    
    for _, child in pairs(rootPart:GetChildren()) do checkAndDestroyKnockback(child) end
    for _, child in pairs(character:GetChildren()) do checkAndDestroyKnockback(child) end

    local lastNormalSpeed = CONFIG.DefaultSpeed
    local lastNormalJump = CONFIG.DefaultJumpPower
    
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not character or not character.Parent then
            connection:Disconnect()
            return
        end
        
        local currentSpeed = humanoid.WalkSpeed
        if currentSpeed > lastNormalSpeed then
            lastNormalSpeed = currentSpeed
        end
        
        local currentJump = humanoid.JumpPower
        if currentJump > lastNormalJump then
            lastNormalJump = currentJump
        end
        
        local velocity = rootPart.AssemblyLinearVelocity
        local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        local yVelocity = velocity.Y
        
        local horizontalKnockbackThreshold = lastNormalSpeed * CONFIG.KnockbackMultiplier
        local verticalKnockbackThreshold = (lastNormalJump * 1.5)
        
        if horizontalSpeed > horizontalKnockbackThreshold then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, yVelocity, 0)
        end
        
        if yVelocity > verticalKnockbackThreshold * CONFIG.JumpMultiplier then
            rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, verticalKnockbackThreshold * CONFIG.JumpMultiplier, velocity.Z)
        end
        
        if yVelocity < -200 then
            rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, -200, velocity.Z)
        end
    end)
    table.insert(connections, connection)
end

-- Funkcja do wyłączania anti-hita
local function disableAntiHit()
    antiHitEnabled = false
    for _, conn in ipairs(connections) do
        conn:Disconnect()
    end
    connections = {}
end

