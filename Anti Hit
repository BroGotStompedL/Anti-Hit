local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

-- Konfiguracja
local CONFIG = {
    DefaultSpeed = 16, -- Normalna prędkość chodzenia
    DefaultJumpPower = 50, -- Normalna siła skoku (domyślna w Roblox)
    KnockbackMultiplier = 5, -- Mnożnik dla speeda
    JumpMultiplier = 5, -- Mnożnik dla jumpa (jak dużo większy knockback pionowy może być)
    AntiSit = true -- Czy blokować wymuszone siadanie
}

local function setupAntiHit(character)
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    -- Funkcja sprawdzająca czy siedzi na prawdziwym siedzeniu
    local function isSittingOnValidSeat()
        local seat = humanoid.SeatPart
        if seat then
            if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
                if seat.Parent and seat.Parent:IsA("Workspace") then
                    return true
                end
            end
        end
        return false
    end
    
    -- Blokowanie wymuszonego siedzenia
    if CONFIG.AntiSit then
        humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
            if humanoid.Sit and not isSittingOnValidSeat() then
                humanoid.Sit = false
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        
        humanoid.StateChanged:Connect(function(_, newState)
            if (newState == Enum.HumanoidStateType.Seated or newState == Enum.HumanoidStateType.PlatformStanding) and not isSittingOnValidSeat() then
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end

    -- Niszczenie wszystkich typów sił / prędkości
    local function checkAndDestroyKnockback(child)
        if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("BodyForce") or child:IsA("VectorForce") or child:IsA("BodyAngularVelocity") or child:IsA("AngularVelocity") then
            task.spawn(function()
                child:Destroy()
            end)
        end
    end

    rootPart.ChildAdded:Connect(checkAndDestroyKnockback)
    character.ChildAdded:Connect(checkAndDestroyKnockback)
    
    for _, child in pairs(rootPart:GetChildren()) do checkAndDestroyKnockback(child) end
    for _, child in pairs(character:GetChildren()) do checkAndDestroyKnockback(child) end

    -- Dynamiczne wykrywanie knockbacku
    local lastNormalSpeed = CONFIG.DefaultSpeed
    local lastNormalJump = CONFIG.DefaultJumpPower
    
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not character or not character.Parent then
            connection:Disconnect()
            return
        end
        
        -- Sprawdź aktualny speed postaci
        local currentSpeed = humanoid.WalkSpeed
        if currentSpeed > lastNormalSpeed then
            lastNormalSpeed = currentSpeed
        end
        
        -- Sprawdź aktualną siłę skoku
        local currentJump = humanoid.JumpPower
        if currentJump > lastNormalJump then
            lastNormalJump = currentJump
        end
        
        local velocity = rootPart.AssemblyLinearVelocity
        local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        local yVelocity = velocity.Y
        
        -- Dynamiczny próg dla prędkości poziomej
        local horizontalKnockbackThreshold = lastNormalSpeed * CONFIG.KnockbackMultiplier
        
        -- Dynamiczny próg dla prędkości pionowej (skakanie)
        -- JumpPower 50 = ~50 studs/s prędkości początkowej
        -- Używamy mnożnika żeby nie blokować normalnych skoków
        local verticalKnockbackThreshold = (lastNormalJump * 1.5) -- 75 dla normalnego jumpa
        
        -- Blokuj tylko nadmierną prędkość poziomą (knockback)
        if horizontalSpeed > horizontalKnockbackThreshold then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, yVelocity, 0)
        end
        
        -- Blokuj tylko nadmierną prędkość pionową (knockback w górę)
        -- Pozwala na normalne skakanie nawet z dużym jumpem
        if yVelocity > verticalKnockbackThreshold * CONFIG.JumpMultiplier then
            rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, verticalKnockbackThreshold * CONFIG.JumpMultiplier, velocity.Z)
        end
        
        -- Nie blokuj prędkości pionowej w dół (spadanie)
        -- Tylko ekstremalne wartości (ochrona przed fall damage)
        if yVelocity < -200 then
            rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, -200, velocity.Z)
        end
    end)
end

-- Obsługa postaci
if localPlayer.Character then
    setupAntiHit(localPlayer.Character)
end

localPlayer.CharacterAdded:Connect(function(newCharacter)
    setupAntiHit(newCharacter)
end)

warn("[ANTI-HIT] Załadowano poprawnie a xenor to cwel.")
